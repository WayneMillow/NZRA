	<!-- 		<color>7fff00ff</color>  -->
			<color>ff000000</color>
			<width>5</width>
		</LineStyle>
		<BalloonStyle id="TeamMembers">
			<text>$[name] $[description]</text>
		</BalloonStyle>
	</Style>
	<StyleMap id="msn_teamroute">
