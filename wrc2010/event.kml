 <Style id="sn_rtflag">
  <IconStyle>
   <color>ff0000ff</color>
   <scale>1.2</scale>
   <Icon>
    <href>http://maps.google.com/mapfiles/kml/shapes/donut.png</href>
   </Icon>
  </IconStyle>
  <ListStyle>
  </ListStyle>
 </Style>
 <Style id="sh_rtflag">
