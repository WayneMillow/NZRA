   <color>ff0000ff</color>
   <scale>1.5</scale>
   <Icon>
    <href>http://maps.google.com/mapfiles/kml/shapes/donut.png</href>
   </Icon>
  </IconStyle>
  <ListStyle>
  </ListStyle>
 </Style>
 <StyleMap id="msn_rtflag">
  <Pair>
   <key>normal</key>
   <styleUrl>#sn_rtflag</styleUrl>
  </Pair>
  <Pair>
   <key>highlight</key>
   <styleUrl>#sh_rtflag</styleUrl>
  </Pair>
 </StyleMap>
	<Style id="sn_normal">
		<LineStyle>
			<color>cfafafaf</color>
			<colorMode>random</colorMode>
			<width>3</width>
		</LineStyle>
	</Style>
	<Style id="sn_highlight">
		<LineStyle>
			<color>ff000000</color>
			<colorMode>normal</colorMode>
			<width>5</width>
		</LineStyle>
	</Style>
	<StyleMap id="msn_teamroute">
		<Pair>
			<key>normal</key>
			<styleUrl>#sn_normal</styleUrl>
		</Pair>
		<Pair>
			<key>highlight</key>
			<styleUrl>#sn_highlight</styleUrl>
		</Pair>
	</StyleMap>
 <Style id="sn_HashHouse">
